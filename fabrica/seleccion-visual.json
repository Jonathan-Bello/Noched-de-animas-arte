  {
   "id": "h4",
   "nombre": "Apagón",
   "lote": "estilo-02",
   "voto": "b",
   "alcance": "preferencia_visual",
   "archivo": null,
   "sha256": "c27aa2946e5d35ba5c4e390195019fa2c4a62950300ada25a0ba7bc4b82f7e20",
   "registrado": "2026-11-28",
   "etapa": "guion",
   "guion": "Vista desde el patio: la casona entera se apaga de golpe, ventana por ventana, hasta quedar como una silueta negra contra el cielo morado. En la única ventana que aún brilla, el Padre Mateo alza su rosario mientras el foco que tiene encima estalla en chispas; la cruz no da luz.",
   "historial": [
    {
     "id": "h4",
     "nombre": "Apagón",
     "lote": "frentes-01",
     "voto": "original",
     "alcance": "preferencia_visual",
