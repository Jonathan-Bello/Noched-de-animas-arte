{
  "expansion": "Los Testigos de la Casona",
  "version": "0.2",
  "estado": "Propuesta basada en reglas aportadas por usuario; sin simulación de partidas completas",
  "role_types": [
    {
      "id": "vigia",
      "rol": "El Vigía",
      "habilidad": "Inventario mental",
      "frecuencia": "CONTINUA · SOLO VIVO",
      "texto": "Si una carta normal o habilidad del ánima te hace descartar al azar, elige qué descartas, sin reducir cantidad. No sirve contra Espantos ni descartes de toda la mano.",
      "color": "#414d67"
    },
    {
      "id": "improvisador",
      "rol": "El Improvisador",
      "habilidad": "Lo que haya a mano",
      "frecuencia": "CONTINUA · SOLO VIVO",
      "texto": "Cada vez que improvises, descarta 1 carta en lugar de 2. Pagas 1 de cordura y consumes tu acción, pero detectas únicamente con 6.",
      "color": "#862d35"
    },
    {
      "id": "tecnico",
      "rol": "El Técnico",
      "habilidad": "Recalibrar",
      "frecuencia": "1 VEZ POR PARTIDA · SOLO VIVO",
      "texto": "Después de que una herramienta específica tuya dé «Nada», repite su dado sin pagar otra cordura. Sustituye el resultado. No sirve con Kit ni al Improvisar.",
      "color": "#204f5c"
    },
    {
      "id": "detective",
      "rol": "El Detective",
      "habilidad": "Una pieza más",
      "frecuencia": "1 VEZ POR PARTIDA · SOLO VIVO",
      "texto": "Al confirmar una evidencia nueva, nombra otra: el ánima te responde en secreto «Sí» o «No». Es una pista; no cuenta como evidencia confirmada.",
      "color": "#65543b"
    },
    {
      "id": "curandera",
      "rol": "La Curandera",
      "habilidad": "Remedio compartido",
      "frecuencia": "CONTINUA · SOLO VIVO",
      "texto": "Al jugar Té de tila en tu turno, cura 3 de cordura a ti o a otro investigador vivo. Gastas tu carta y tu acción. La cordura no puede superar 10.",
      "color": "#4a5843"
    },
    {
      "id": "padre",
      "rol": "El Padre",
      "habilidad": "Rezar por otro",
      "frecuencia": "CONTINUA · SOLO VIVO",
      "texto": "Puedes gastar un Rosario de tu mano para salvar a otro investigador cazado. No sirve si esa cacería prohíbe el Rosario.",
      "color": "#5a2c42"
    },
    {
      "id": "sensitiva",
      "rol": "La Sensitiva",
      "habilidad": "El último testimonio",
      "frecuencia": "CONTINUA · SOLO VIVO",
      "texto": "Cuando muera otro investigador, el ánima también te muestra en secreto la evidencia que muestra a su espíritu. Es una pista; no una confirmación.",
      "color": "#5b284e"
    },
    {
      "id": "guardaespaldas",
      "rol": "El Guardaespaldas",
      "habilidad": "Ponte detrás de mí",
      "frecuencia": "1 VEZ POR PARTIDA · SOLO VIVO",
      "texto": "Cuando cacen a otro, puedes recibir tú una de sus cacerías y defenderte. Debes tener 4 o menos y poder ser cazado. No sirve contra Espantos.",
      "color": "#535343"
    }
  ],
