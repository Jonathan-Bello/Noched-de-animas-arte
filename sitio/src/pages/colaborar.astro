---
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import { REPOSITORIO, url } from "../lib/url";
import sitio from "../data/sitio.json";

const PASOS = [
  "Elige una pieza en Producción o escribe a Jonathan, el director del proyecto.",
  "Pide el brief de la pieza: la escena, los rasgos de los personajes y las referencias de su familia.",
  "Entrega la ilustración: vertical 2:3, PNG de al menos 1024 × 1536 px, sin letras ni marco, con aire arriba y abajo para el título y la leyenda. Nombre: <id-del-juego>__v<n>.png.",
  "Se revisa el archivo y cómo queda dentro de la plantilla a tamaño de carta.",
  "Jonathan la compara con las cartas aprobadas y decide: aprobada, corregir o rechazada.",
];
const REVISION = [
  "Formato, proporción vertical y resolución.",
  "La escena respeta las zonas del título y la leyenda.",
  "Manos y anatomía; rostro, pelo y ropa cuando hay personajes.",
  "Paleta, textura y acabado como las cartas de su familia.",
];
const porDefinir = (v: string | null) => v ?? "Por definir.";
---
<Base titulo="Cómo colaborar" descripcion="Cómo entregar una ilustración para Noche de Ánimas y cómo se revisa." actual="colaborar.html">
  <Encabezado antetitulo="Del encargo a la carta aprobada" titulo="Cómo colaborar" entrada="Qué entregar, cómo se revisa y dónde registrarlo." />

  <section class="contenedor seccion grid gap-10 lg:grid-cols-[3fr_2fr]">
    <div>
      <h2>Pasos</h2>
      <ol class="mt-6 space-y-4">
        {PASOS.map((p, i) => (
          <li class="flex gap-4"><span class="grid size-8 shrink-0 place-items-center rounded-full bg-oro font-titulo text-noche">{i + 1}</span><p class="pt-1">{p}</p></li>
        ))}
      </ol>
    </div>
    <div class="space-y-4">
      <div class="tarjeta">
        <h3>Entregar por GitHub</h3>
        <p class="mt-2 text-sm text-tenue">Abre un Issue con el id de la carta y adjunta la ilustración. La revisión se documenta en el mismo hilo.</p>
        <a class="boton mt-4" href={`${REPOSITORIO}/issues/new?template=propuesta-de-arte.yml`}>Entregar una propuesta</a>
      </div>
      <div class="tarjeta">
        <h3>Otro contacto</h3>
        <p class="mt-2 text-sm text-tenue">{porDefinir(sitio.contacto)}</p>
      </div>
    </div>
  </section>

  <section class="contenedor grid gap-6 md:grid-cols-3">
    <div class="tarjeta">
      <h2 class="text-xl sm:text-2xl">Qué se revisa</h2>
      <div class="prosa mt-3 text-sm text-tenue"><ul>{REVISION.map((r) => <li>{r}</li>)}</ul></div>
      <p class="mt-3 text-sm"><a href={url("sistema-de-diseno.html")}>Ver el sistema de diseño</a></p>
    </div>
    <div class="tarjeta">
      <h2 class="text-xl sm:text-2xl">Uso de IA</h2>
      <p class="mt-3 text-sm text-tenue">Se permite como herramienta, siempre declarada y con el prompt exacto. Hay que trabajar con el estilo y las referencias aprobadas. Las fotos de personas necesitan su permiso y no se publican.</p>
    </div>
    <div class="tarjeta">
      <h2 class="text-xl sm:text-2xl">Derechos y crédito</h2>
      <p class="mt-3 text-sm text-tenue">Noche de Ánimas y todo su arte: todos los derechos reservados.</p>
      <p class="mt-2 text-sm text-tenue">Crédito a colaboradores: {porDefinir(sitio.credito_colaborador)}</p>
    </div>
  </section>
</Base>
