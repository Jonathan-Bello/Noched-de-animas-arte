---
import { url } from "../lib/url";
interface Props {
  src: string | null;
  alt: string;
  /** Ancho en px de la miniatura mostrada. */
  ancho?: number;
  pie?: string;
}
const { src, alt, ancho = 145, pie } = Astro.props;
const alto = Math.round((ancho * 88) / 58);
---
<figure class="shrink-0" style={`width:${ancho}px`}>
  {src ? (
    <img src={url(src)} alt={alt} width={ancho} height={alto} loading="lazy" decoding="async"
      class="aspect-[58/88] w-full rounded-md object-cover shadow-lg shadow-black/40" />
  ) : (
    <div class="grid aspect-[58/88] w-full place-items-center rounded-md border border-dashed border-linea text-center text-xs text-tenue" role="img" aria-label={`${alt}: sin arte todavía`}>Sin arte todavía</div>
  )}
  {pie && <figcaption class="mt-1.5 text-xs text-tenue">{pie}</figcaption>}
</figure>
