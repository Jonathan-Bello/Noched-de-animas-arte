---
import "../styles/global.css";
import { NAVEGACION, REPOSITORIO, url } from "../lib/url";

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta de la página en NAVEGACION, para marcarla como actual. */
  actual?: string;
}
const { titulo, descripcion, actual } = Astro.props;
const tituloCompleto = titulo === "Inicio" ? "Noche de Ánimas · Archivo de arte" : `${titulo} · Noche de Ánimas`;
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={new URL(url("web/miniaturas/id01@2x.webp"), Astro.site)} />
    <meta name="theme-color" content="#171117" />
    <link rel="icon" href={url("web/miniaturas/id01.webp")} />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-oro focus:px-3 focus:py-2 focus:text-noche">Saltar al contenido</a>

    <header class="sticky top-0 z-40 border-b border-linea bg-noche/95 backdrop-blur">
      <div class="contenedor flex items-center justify-between gap-4 py-3">
        <a href={url("index.html")} class="font-titulo text-lg text-oro no-underline">Noche de Ánimas</a>
        <!-- Escritorio -->
        <nav aria-label="Secciones" class="hidden lg:block">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {NAVEGACION.slice(1).map((n) => (
              <li>
                <a href={url(n.ruta)} aria-current={n.ruta === actual ? "page" : undefined}
                  class:list={["no-underline hover:text-oro", n.ruta === actual ? "text-oro underline decoration-2" : "text-crema"]}>{n.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
        <!-- Celular -->
        <details class="relative lg:hidden">
          <summary class="cursor-pointer list-none rounded-lg border border-linea px-3 py-1.5 text-sm">Secciones</summary>
          <nav aria-label="Secciones" class="absolute right-0 mt-2 w-60 rounded-xl border border-linea bg-superficie p-2 shadow-2xl">
            <ul>
              {NAVEGACION.map((n) => (
                <li>
                  <a href={url(n.ruta)} aria-current={n.ruta === actual ? "page" : undefined}
                    class:list={["block rounded-lg px-3 py-2 no-underline hover:bg-superficie-alta", n.ruta === actual ? "text-oro" : "text-crema"]}>{n.texto}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="mt-16 border-t border-linea">
      <div class="contenedor flex flex-col gap-3 py-8 text-sm text-tenue sm:flex-row sm:items-center sm:justify-between">
        <p><span class="font-titulo text-crema">Noche de Ánimas</span> · Todos los derechos reservados.</p>
        <p class="flex flex-wrap gap-4">
          <a href={url("aprobados.html")}>Archivo de aprobaciones</a>
          <a href={REPOSITORIO}>Repositorio ↗</a>
        </p>
      </div>
    </footer>
  </body>
</html>
